# Required: Postgres connection string (Neon). On Vercel this is set by the Neon integration.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: shared secret the phone sends in "Authorization: Bearer <secret>"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: protect the dashboard with HTTP Basic Auth (username: admin)
DASHBOARD_PASSWORD=
